{
  "name": "riloom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "typecheck": "pnpm -r --sort typecheck && tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint apps packages tests",
    "format": "prettier --check \"apps/**/*.{ts,tsx,css,json,html}\" \"packages/**/*.{ts,json}\" \"tests/**/*.{ts,mjs,json}\" \"*.{json,mjs,ts,yaml}\"",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm check:docs",
    "start": "node apps/cli/dist/index.js",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "24.10.1",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "pngjs": "7.0.0",
    "@types/pngjs": "6.0.5",
    "playwright": "1.56.1"
  }
}
